; Modern Telengard Godot presentation placeholder.
; The Godot .NET project is intentionally separate from the headless solution.
config_version=5

[application]
config/name="Modern Telengard"
run/main_scene=""

[display]
window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]
renderer/rendering_method="gl_compatibility"
